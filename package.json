{
  "name": "the-hashfork-list",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted, SQLite-backed directory of GitHub projects, LLMs, models and AI tools — no auth, no external services.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "core-js": true
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.47.0",
    "next": "^15.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.32.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
