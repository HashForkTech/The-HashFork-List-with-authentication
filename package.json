{
  "name": "the-hashfork-list",
  "version": "1.0.0",
  "private": true,
  "description": "A curated resource directory with cookie-free admin authentication and SQLite or Supabase storage.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "certs:generate": "node scripts/generate-certs.mjs",
    "dev:https": "node scripts/dev-https.mjs",
    "db:migrate:supabase": "node scripts/migrate-supabase.mjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "core-js": true
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.47.0",
    "next": "^15.5.0",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.32.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
