# Copy to .env and fill the two secrets before production / Docker startup.
# The admin creates a password in the first-login setup screen. No password
# belongs in this file: the application retains only a salted Argon2id verifier.

# sqlite for a local Node server / Docker; supabase for Vercel.
DATABASE_PROVIDER=sqlite
DATA_DIR=./data
DATABASE_FILE=hashfork.sqlite

# Supabase Postgres connection string, server-only. Copy the Transaction pooler
# string from the Supabase Connect dialog for Vercel; URL-encode its password.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER-HOST:6543/postgres
# Optional trusted database root CA file for verified TLS.
# DATABASE_CA_CERT=/absolute/path/to/root-ca.pem

# High-entropy, one-time first-login setup secret (at least 32 characters).
# Generate: openssl rand -hex 32
ADMIN_SETUP_TOKEN=

# 32 random bytes encoded as base64; required for admin setup / 2FA. Keep it for
# restores: it encrypts the TOTP secret. Generate: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=

# Admin sessions are held only in browser memory; refresh requires sign-in.
AUTH_SESSION_MINUTES=60

# Public origin; production admin access requires HTTPS.
# For Docker's local TLS overlay the app uses https://localhost:8443 instead.
APP_URL=https://localhost:3000

# Production admin access requires a controlled HTTPS proxy and this set to true.
# The proxy must overwrite forwarded headers; keep the raw Node port private.
TRUST_PROXY=false

# Enable after configuring a trusted production HTTPS certificate.
# Keep false for localhost self-signed certificate tests.
ENABLE_HSTS=false
