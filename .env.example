# ──────────────────────────────────────────────────────────────────────────────
# The Hashfork List — environment configuration (all optional)
#
# This build has NO admin authentication: no accounts, no passwords, no
# session cookies and therefore no TLS/SSL certificate requirement. There is
# no secret to configure. Copy this file to `.env` only to override defaults.
# ──────────────────────────────────────────────────────────────────────────────

# Where the SQLite database lives.
# MUST point to a persistent volume in production — see README "Deployment".
DATA_DIR=./data

# Database file name inside DATA_DIR.
DATABASE_FILE=hashfork.sqlite

# Public origin of the application (metadata base URL + cross-origin request
# host allow-list for write operations).
APP_URL=http://localhost:3000

# Set to "false" when NOT running behind a reverse proxy / load balancer so
# client IPs and hosts are read from the direct connection only.
TRUST_PROXY=true

# Send HSTS — only enable when serving over HTTPS (opt-in, default: off).
# Plain-HTTP deployments work fine without it.
ENABLE_HSTS=false
